# 改变忽略规则的顺序和具体性
*.pyc
**/__pycache__/

# 先忽略特定的大型数据目录
data/
datasets/

# 但不忽略特定的 data 子目录
!MME-RealWorld-Lite/data/
!MathVision/data/

# 然后在特定的 data 子目录中忽略大多数文件
MME-RealWorld-Lite/data/*
MathVision/data/*

# 但保留特定文件
!MME-RealWorld-Lite/data/unzip_file.sh
!MME-RealWorld-Lite/data/MME-RealWorld-Lite.json
!MathVision/data/test.jsonl

# 忽略 images 目录中的所有文件，但保留目录结构
**/images/*

# 忽略所有日志文件
*.log
**/*.log
logs/
**logs/

# 忽略大型模型文件
*.bin
*.safetensors
*.onnx
*.pt
*.pth
*.model
*.pkl

# 忽略数据集文件
*.csv
*.tsv
**/*.parquet

# 忽略大型目录
models/
checkpoints/

**/*.zip

test/
*_official/
tmp/**
results/
outputs/